# npm 10.9.x fails to resolve vitest's dependency graph:
#
#   npm error Cannot read properties of null (reading 'edgesOut')
#
# The cause is vitest's large set of wildcard optional peers (`jsdom: "*"`,
# `happy-dom: "*"`, `@edge-runtime/vm: "*"`, ...). npm 11 resolves it correctly;
# this setting makes npm 10 install the same tree without touching the machine's
# global npm.
#
# Every dependency this project actually needs is pinned explicitly in
# package.json, so skipping automatic peer installation changes nothing here.
legacy-peer-deps=true
