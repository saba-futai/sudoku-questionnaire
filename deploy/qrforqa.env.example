# QRforQA service configuration.
#
# Install at /etc/qrforqa/qrforqa.env with mode 0600, owned by root.
# deploy/install.sh generates the secrets on first install.

# ----------------------------------------------------------------- secrets ---
# Seeds every per-questionnaire sudoku table. Rotating this makes every stored
# ciphertext undecodable, so back it up alongside the database.
QRFORQA_MASTER_KEY=__GENERATE__

# Signs admin session tokens. Independent of the master key on purpose.
QRFORQA_JWT_SECRET=__GENERATE__

# Seeded into the database on first run only; changing it later has no effect
# (use the settings page to change the password).
QRFORQA_ADMIN_USER=admin
QRFORQA_ADMIN_PASSWORD=__GENERATE__

# ---------------------------------------------------------------- listeners ---
# The whole application — frontend and API — is served here.
#
# Deliberately NOT 80: on a shared host that port is usually already taken by
# a web server, and taking it would be rude at best. 3388 is a plain high port
# with no conventional meaning, so nothing else is likely to want it.
QRFORQA_ADDR=:3388
# Optional second listener, for a separately-firewalled backend port.
# Leave empty to disable.
QRFORQA_ALT_ADDR=:3389

# ----------------------------------------------------------------- storage ---
QRFORQA_DATA_DIR=/opt/qrforqa/data
QRFORQA_DB=/opt/qrforqa/data/qrforqa.db

# ---------------------------------------------------------------- behaviour ---
# ascii keeps ciphertext storable as text; entropy is binary-only.
QRFORQA_LAYOUT=ascii
QRFORQA_TOKEN_TTL=12h
# Cap on a single image's ciphertext (~4x the base64, ~5.33x the raw image).
QRFORQA_MAX_UPLOAD_BYTES=2097152
QRFORQA_DEV=0
